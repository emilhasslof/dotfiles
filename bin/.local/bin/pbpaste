#!/usr/bin/env bash
# Portable pbpaste shim: print the system clipboard to stdout on any platform.
if [ "$(uname)" = "Darwin" ]; then exec /usr/bin/pbpaste; fi
if command -v wl-paste >/dev/null 2>&1; then exec wl-paste --no-newline; fi
if command -v xclip    >/dev/null 2>&1; then exec xclip -selection clipboard -o; fi
if command -v xsel     >/dev/null 2>&1; then exec xsel  --clipboard --output; fi
echo "pbpaste: no clipboard tool found (install wl-clipboard or xclip)" >&2
exit 1
